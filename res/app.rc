// Icon (id 1) and manifest: common controls v6 (modern buttons, tabs),
// no elevation. DPI awareness is set in code (main.cpp). The version comes
// from CMakeLists.txt (generated version.h).
#include <winuser.h>

#include "version.h"

1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION GCT_VER_MAJOR,GCT_VER_MINOR,GCT_VER_PATCH,0
PRODUCTVERSION GCT_VER_MAJOR,GCT_VER_MINOR,GCT_VER_PATCH,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Emi"
      VALUE "FileDescription", "GW2 Chat Translator"
      VALUE "FileVersion", GCT_VERSION_STR
      VALUE "ProductName", "GW2 Chat Translator"
      VALUE "ProductVersion", GCT_VERSION_STR
      VALUE "OriginalFilename", "GW2ChatTranslator.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
