// Icon (id 1) and manifest: common controls v6 (modern buttons, tabs),
// no elevation. DPI awareness is set in code (main.cpp).
#include <winuser.h>

1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION 0,5,0,0
PRODUCTVERSION 0,5,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Emi"
      VALUE "FileDescription", "GW2 Chat Translator"
      VALUE "FileVersion", "0.5.0"
      VALUE "ProductName", "GW2 Chat Translator"
      VALUE "ProductVersion", "0.5.0"
      VALUE "OriginalFilename", "GW2ChatTranslator.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
