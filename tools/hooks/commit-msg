#!/usr/bin/env python
# A behaviour change (feat, fix, perf, refactor) carries an "Evidence:" trailer – AGENTS.md, Working Modes.
# Switched on once per clone: git config core.hooksPath tools/hooks
import pathlib
import subprocess
import sys

root = pathlib.Path(__file__).resolve().parent.parent.parent
sys.exit(subprocess.call([sys.executable, str(root / "tools" / "check_evidence.py"), "--message-file", sys.argv[1]]))
